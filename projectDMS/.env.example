# Global
COMPOSE_PROJECT_NAME=contract-ai
ENVIRONMENT=production
ENABLE_API_DOCS=false
ALLOW_DEV_HEADERS=false
RBAC_ENTITLEMENT_FAIL_OPEN=false
PUBLIC_BASE_URL=https://app.example.com
PUBLIC_API_URL=https://app.example.com/api
APP_URL=https://app.example.com
DOCUMENT_SHARE_TOKEN_TTL_DAYS=30
SHARE_EMAIL_ATTACHMENT_MAX_MB=15

# Backend API
BACKEND_PORT=8000
BACKEND_WORKERS=4
SECRET_KEY=replace-with-64-character-random-secret
AUTH_COOKIE_NAME=cc_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
# Deny authentication (503) while the session store (runtime Redis) is
# unreachable, so revoked sessions cannot outlive a Redis outage. Set false
# only to consciously prefer availability over revocation enforcement.
AUTH_SESSION_FAIL_CLOSED=true
LOGIN_IP_RATE_LIMIT_REQUESTS=100
LOGIN_IP_RATE_LIMIT_WINDOW=100
LOGIN_EMAIL_RATE_LIMIT_REQUESTS=100
LOGIN_EMAIL_RATE_LIMIT_WINDOW=3600
CORS_ORIGINS=https://app.example.com
DATABASE_URL=mongodb://app_user:replace-with-password@mongo1.example.internal:27017,mongo2.example.internal:27017,mongo3.example.internal:27017/contraclaim?replicaSet=rs0&authSource=admin&retryWrites=true
MONGODB_URI=mongodb://app_user:replace-with-password@mongo1.example.internal:27017,mongo2.example.internal:27017,mongo3.example.internal:27017/contraclaim?replicaSet=rs0&authSource=admin&retryWrites=true
MONGODB_DATABASE=contraclaim
MONGODB_APP_NAME=ContractDMS
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=20000
MONGODB_REPLICA_SET=rs0
MONGODB_RETRY_WRITES=true
MONGODB_ALLOW_STANDALONE_PRODUCTION=false
UPLOAD_STREAM_CHUNK_SIZE_MB=1
UPLOAD_VALIDATION_SAMPLE_BYTES=8192
GENERAL_UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_CONCURRENT_PER_USER=3
UPLOAD_MAX_CONCURRENT_PER_ORG=20
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=replace-with-bucket-name

# OpenAI / AI Providers
# OpenAI configuration
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o

# Qdrant
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=contracts
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=15

# FalkorDB
GRAPH_PROVIDER=direct_falkor
FALKORDB_ENABLED=true
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_URL=redis://falkordb:6379
FALKORDB_GRAPH_NAME=contraclaim
FALKORDB_CLEANUP_REFERENCES=true
FALKORDB_PASSWORD=

# Optional Graphiti API.
# ⚠️  EXPERIMENTAL — Only available when running the Docker Compose
#    "graph-experimental" profile.  The production graph provider is
#    direct FalkorDB (GRAPH_PROVIDER=direct_falkor).  Enabling Graphiti
#    additionally requires setting GRAPH_PROVIDER=graphiti.
GRAPHITI_ENABLED=false
GRAPHITI_API_URL=
GRAPHITI_BASE_URL=
GRAPHITI_API_KEY=
GRAPHITI_WORKSPACE=ContraClaim
GRAPHITI_GRAPH_NAME=contraclaim

# Redis
REDIS_PASSWORD=
APP_REDIS_URL=redis://redis:6379/1
RUNTIME_STATE_REDIS_URL=redis://redis:6379/1
CONTRACT_QUEUE_REDIS_URL=redis://redis:6379/0
START_BACKGROUND_SERVICES=true
START_CONTRACT_QUEUE_WORKERS=true

# Docling Service
# ⚠️  NOT DEPLOYED — The Docling microservice (services/docling/) is not
#    registered in any Docker Compose file.  These variables only apply if
#    the service is started manually.  The production OCR pipeline uses
#    backend/rbac_backend/services/ocr_service.py instead.
DOCLING_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.bmp,.docx,.pptx
DOCLING_MAX_FILE_SIZE_MB=150
DOCLING_LOG_LEVEL=INFO

# Marker CLI (contract ingestion)
# Requires Marker CLI installed and available on PATH.
MARKER_ENABLED=true
MARKER_CMD=marker
MARKER_OUTPUT_DIR=uploads/marker

# Vector database integration
VECTORDB_URL=http://qdrant:6333
VECTORDB_API_KEY=
VECTORDB_COLLECTION=documents
VECTORDB_BATCH_SIZE=64
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LangGraph / Orchestration
# Set LANGGRAPH_ENABLED=true to activate the AI letter drafting pipeline.
# When enabled, LANGGRAPH_API_TOKEN is required in production.
LANGGRAPH_ENABLED=false
LANGGRAPH_API_TOKEN=change-me
LANGGRAPH_DEFAULT_AGENT=contract_drafter

# Arbitration pleading workflow rollout. Keep off/v2/non-accepted until the
# Phase-5 production-like acceptance matrix and restore drill have passed.
ARBITRATION_ENGINE_DEFAULT=arbitration_v2
ARBITRATION_ENGINE_ROLLOUT_MODE=off
ARBITRATION_ENGINE_CANARY_PERCENT=0
ARBITRATION_ENGINE_CANARY_TENANT_IDS=
ARBITRATION_ENGINE_CANARY_PROJECT_IDS=
ARBITRATION_ENGINE_FORCE_V2_TENANT_IDS=
ARBITRATION_ENGINE_FORCE_V2_PROJECT_IDS=
ARBITRATION_ENGINE_ROLLOUT_PAUSED=false
ARBITRATION_ENGINE_GRAPH_VERSION=phase4-v1
ARBITRATION_ENGINE_STATE_SCHEMA_VERSION=2
ARBITRATION_ENGINE_PRODUCTION_ACCEPTED=false
ARBITRATION_ENGINE_MAX_CHECKPOINT_BYTES=262144
ARBITRATION_ENGINE_CHECKPOINT_RETENTION_DAYS=30
ARBITRATION_ENGINE_RETRY_BUDGET=3
ARBITRATION_ENGINE_MAX_REMEDIATION_CYCLES=1
ARBITRATION_ENGINE_MIN_ACCEPTANCE_SAMPLE=20
ARBITRATION_ENGINE_MIN_SHADOW_PARITY_PERCENT=99
ARBITRATION_ENGINE_MAX_FAILURE_RATE_PERCENT=2
ARBITRATION_ENGINE_MAX_FALLBACK_RATE_PERCENT=5
ARBITRATION_ENGINE_MAX_PAUSE_HOURS=72

# Antivirus Configuration
# P0-005: production requires upload antivirus enabled and fail-closed. Startup
# validation refuses to boot in production when ANTIVIRUS_ENABLED=false unless
# ANTIVIRUS_REQUIRED_IN_PRODUCTION=false is set to explicitly accept the risk.
ANTIVIRUS_ENABLED=true
ANTIVIRUS_REQUIRED_IN_PRODUCTION=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
CLAMAV_FAIL_OPEN=false

# Logging & Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-internal-scrape-token
SLOW_REQUEST_THRESHOLD_MS=2000
BACKUP_ROOT=/var/backups/contractdms
BACKUP_MAX_AGE_HOURS=26
BACKUP_REQUIRED_IN_PRODUCTION=true
BACKUP_REQUIRED_VOLUME_LABELS=backend-uploads,qdrant-data,falkordb-data,redis-data
BACKUP_S3_BUCKET=replace-with-backups-bucket
BACKUP_S3_PREFIX=contraclaim/backups

# Optional SMTP / Notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=replace-with-email-username
EMAIL_PASSWORD=replace-with-email-app-password
EMAIL_FROM=noreply@example.com

# SMTP configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="ContraClaim DMS"
SMTP_ENCRYPTION=starttls
SMTP_SETTINGS_ENCRYPTION_KEY=replace-with-fernet-key-or-32-byte-secret
CONTACT_RECIPIENT_EMAIL=support@example.com

# Local durable storage inside containers. The production Compose file mounts a
# named Docker volume here; use S3-primary storage only after a write/read smoke.
UPLOADS_DIR=/app/uploads
SECURE_UPLOADS_DIR=/app/uploads

# --- Payment gateway (Razorpay) ---
# PAYMENT_PROVIDER=noop disables billing (default). Set to razorpay for live billing
# and fill the keys from the Razorpay dashboard. Webhook URL: /api/billing/webhooks/razorpay
PAYMENT_PROVIDER=noop
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SSO (generic OpenID Connect) ---
# Set OIDC_ENABLED=true and fill issuer/client to enable /api/auth/sso/login.
# Works with Microsoft Entra ID, Google, Okta, Auth0, Keycloak, etc.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_AUTO_PROVISION=true
OIDC_DEFAULT_ROLE=orguser
OIDC_DEFAULT_ORG_ID=

# --- Tracing (OpenTelemetry, opt-in) ---
# Install opentelemetry-* packages + set these to export traces to a collector.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=contraclaim-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
